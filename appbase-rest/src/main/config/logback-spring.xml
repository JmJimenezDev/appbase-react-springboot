<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty name="LOG_FOLDER" source="log.folder"/>
    <springProperty name="APPLICATION" source="spring.application.name"/>
    
    <conversionRule conversionWord="highlightex" class="dev.jmjimenez.appbase_rest.config.HighlightingCompositeConverterEx" />
    
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
        	<charset>utf-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [${HOSTNAME:-unknown}][%X{sessionId}] [%X{userId}] [%highlightex(%-5level)] [%blue(%t)] [%yellow(%c{1})]: %msg%n%throwable</pattern>
        </encoder>
    </appender>
    
    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FOLDER}/${APPLICATION}.log</file>
        <encoder>
            <charset>utf-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [${HOSTNAME:-unknown}][%X{sessionId}] [%X{userId}] [%-5level] [%t] [%c{1}]: %msg%n%throwable</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FOLDER}/archived/${APPLICATION}-%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
        </rollingPolicy>
    </appender>
    
    <!-- TODO: implementar logstash -->
    <!--<appender name="AsyncRollingFile" class="net.logstash.logback.appender.LoggingEventAsyncDisruptorAppender">
    	<appender-ref ref="RollingFile" />
    	<includeCallerData>true</includeCallerData>
    </appender>-->

    <root additivity="false">
        <appender-ref ref="RollingFile"/>
        <appender-ref ref="Console"/>
    </root>
    
    <!-- Logger exclusivo de auditoría -->
    <appender name="AuditFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FOLDER}/audit.log</file>
        <encoder>
            <charset>utf-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [${HOSTNAME:-unknown}] [%X{userId}] [%X{ip}] [AUDIT] %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FOLDER}/archived/audit-%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>
    
    <logger name="AUDIT_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="AuditFile"/>
    </logger>
</configuration>
